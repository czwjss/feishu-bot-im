{
  "name": "@czwjss/feishu-bot-im",
  "version": "0.9.0",
  "type": "module",
  "description": "飞书机器人：DeepSeek Harness 的飞书接入插件（多机器人、扫码接入、卡片回复、上下文注入、用户分身）",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/user-identity.md",
    "docs/user-identity-architecture.md",
    "docs/user-identity-architecture.html",
    "docs/feishu-scopes.md",
    "docs/user-message-monitor-design.md",
    "docs/feishu-avatar-message-flow.svg",
    "docs/tool-mounting-comparison.html",
    "docs/bot-inbound-flow.html"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.73.0",
    "qrcode": "1.5.4"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build:client": "node scripts/build-client.mjs",
    "pretest": "npm run build:client",
    "prepublishOnly": "npm run build:client"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czwjss/feishu-bot-im.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "feishu",
    "lark",
    "im",
    "bot",
    "plugin"
  ],
  "homepage": "https://github.com/czwjss/feishu-bot-im#readme",
  "bugs": {
    "url": "https://github.com/czwjss/feishu-bot-im/issues"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
